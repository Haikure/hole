# Copy to signing.env (gitignored). Values are Bash assignments.
# Paths may be absolute, $HOME-based, or relative to the repository root.
# Existing nonempty HOLE_SIGNING_* environment variables take precedence.
HOLE_SIGNING_STORE_FILE="$HOME/.android/release.keystore"
HOLE_SIGNING_STORE_PASSWORD='STORE_PASSWORD'
HOLE_SIGNING_KEY_ALIAS='KEY_ALIAS'
HOLE_SIGNING_KEY_PASSWORD='KEY_PASSWORD'
