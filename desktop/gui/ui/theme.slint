// 与 Android HoleTheme 的五组调色板、表面层级和圆角保持一致。
// teal / violet 保留桌面标识，分别对应 Android 的 green / purple。
import { Palette } from "std-widgets.slint";

export global Theme {
    // 由 Palette.color-scheme 派生；MainWindow 的 apply-theme-mode 负责改写 Palette。
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;

    // 强调色：系统未提供时回落默认蓝色；Rust 侧可按用户偏好覆盖。
    in-out property <string> palette: "blue";
    out property <color> accent-light: palette == "teal" ? #386B4B : palette == "violet" ? #66508D : palette == "rose" ? #98445F : palette == "amber" ? #805610 : #435E91;
    out property <color> accent-dark: palette == "teal" ? #9BD5A9 : palette == "violet" ? #D0B9FF : palette == "rose" ? #FFB1C7 : palette == "amber" ? #F2BF6B : #ADC6FF;
    out property <color> accent: dark ? accent-dark : accent-light;
    out property <color> accent-soft: dark
        ? (palette == "teal" ? #31583D : palette == "violet" ? #503B78 : palette == "rose" ? #79334A : palette == "amber" ? #634400 : #294677)
        : (palette == "teal" ? #D0EAD4 : palette == "violet" ? #E9DDFF : palette == "rose" ? #FFD9E2 : palette == "amber" ? #FFDDA8 : #D8E2FF);
    out property <color> on-accent: !dark ? #FFFFFF : palette == "teal" ? #173622 : palette == "violet" ? #35205C : palette == "rose" ? #5A1930 : palette == "amber" ? #442C00 : #102F60;
    out property <color> on-container: dark
        ? (palette == "teal" ? #C0F0C9 : palette == "violet" ? #EBDDFF : palette == "rose" ? #FFD9E2 : palette == "amber" ? #FFDDA8 : #D8E2FF)
        : (palette == "teal" ? #102617 : palette == "violet" ? #24163E : palette == "rose" ? #3D071B : palette == "amber" ? #2A1800 : #001A40);

    // 内容区表面层级
    out property <color> bg: dark ? #121216 : #FAF9FC;
    out property <color> sidebar: dark ? #1C1B20 : #F3F2F7;
    out property <color> surface: dark ? #201F25 : #FFFFFF;
    out property <color> surface-alt: dark ? #2B2930 : #EEEEF3;
    out property <color> surface-hover: dark ? #35333B : #E8E7ED;
    out property <color> border: dark ? #48454F : #CBC9D2;
    out property <color> border-strong: dark ? #899691 : #78847F;
    out property <color> shadow: dark ? #00000040 : #172B4010;
    out property <color> scrim: dark ? #000000A6 : #1A2B3D5C;

    // 文字
    out property <color> text: dark ? #E5E1E9 : #1B1B20;
    out property <color> text-muted: dark ? #CBC5D1 : #48474F;
    out property <color> text-faint: dark ? #778391 : #84909D;

    // 状态色：只用于状态，不作为序列色；总是配合文字或图标。
    out property <color> good: dark ? #4ADE80 : #15803D;
    out property <color> good-soft: dark ? #14532D80 : #DCF3E1;
    out property <color> warn: dark ? #FBBF24 : #9A5B0B;
    out property <color> warn-soft: dark ? #78350F80 : #FCEFCB;
    out property <color> bad: dark ? #F87171 : #B42318;
    out property <color> bad-soft: dark ? #7F1D1D80 : #FDE7E4;
    // 实底危险按钮用固定深红，两种模式下都保证白字对比度。
    out property <color> bad-solid: #B42318;
    out property <color> info: accent;
    out property <color> info-soft: accent-soft;
    out property <color> idle: text-faint;
    out property <color> idle-soft: surface-alt;

    // 数据图形（流量曲线）使用两种不同明度的同一色相，不占用状态色。
    out property <color> series-up: dark ? #93C5FD : #1D4ED8;
    out property <color> series-down: dark ? #5EEAD4 : #0F766E;
    out property <color> grid: dark ? #2F343D : #E8EBEF;

    // 尺寸
    out property <length> radius-sm: 8px;
    out property <length> radius: 12px;
    out property <length> radius-lg: 20px;
    out property <length> space-1: 4px;
    out property <length> space-2: 8px;
    out property <length> space-3: 12px;
    out property <length> space-4: 16px;
    out property <length> space-5: 24px;
    out property <length> space-6: 32px;
    out property <length> sidebar-width: 208px;
    out property <length> topbar-height: 56px;

    // 字号
    out property <length> font-xs: 12px;
    out property <length> font-sm: 12px;
    out property <length> font-body: 14px;
    out property <length> font-md: 14px;
    out property <length> font-lg: 18px;
    out property <length> font-xl: 20px;
    out property <length> font-display: 28px;

    // 动效
    in-out property <bool> reduce-motion: false;
    in-out property <bool> window-visible: true;
    in-out property <string> active-page: "overview";
    callback finish-motion();
    changed reduce-motion => { if reduce-motion { finish-motion(); } }
    out property <duration> motion-fast: reduce-motion ? 0ms : 140ms;
    out property <duration> motion: reduce-motion ? 0ms : 220ms;
    out property <duration> motion-slow: reduce-motion ? 0ms : 320ms;

    pure public function kind-color(kind: string) -> color {
        if kind == "good" { return good; }
        if kind == "warn" { return warn; }
        if kind == "bad" { return bad; }
        if kind == "info" { return info; }
        return idle;
    }
    pure public function kind-soft(kind: string) -> color {
        if kind == "good" { return good-soft; }
        if kind == "warn" { return warn-soft; }
        if kind == "bad" { return bad-soft; }
        if kind == "info" { return info-soft; }
        return idle-soft;
    }
}
