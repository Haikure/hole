// 24x24 视口的线性图标，用 Path 命令绘制，避免依赖图标字体或 SVG 资源。
import { Theme } from "theme.slint";

export global Icons {
    out property <string> overview: "M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z";
    out property <string> mappings: "M4 7h13M13 3l4 4-4 4M20 17H7M11 13l-4 4 4 4";
    out property <string> devices: "M3 5h18v11H3zM8 20h8M12 16v4";
    out property <string> diagnostics: "M3 12h4l3-8 4 16 3-8h4";
    out property <string> settings: "M12 8a4 4 0 1 0 0.01 0M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.2 2.2M16.9 16.9l2.2 2.2M19.1 4.9l-2.2 2.2M7.1 16.9l-2.2 2.2";
    out property <string> transport: "M2 12h4M18 12h4M6 12a6 6 0 0 1 12 0a6 6 0 0 1 -12 0M12 6v-4M12 22v-4";
    out property <string> exchange: "M14 3H6v18h12V7zM14 3v4h4M9 13h6M12 10v6";
    out property <string> plus: "M12 5v14M5 12h14";
    out property <string> refresh: "M20 11a8 8 0 0 0 -14.5 -4.5L3 9M4 13a8 8 0 0 0 14.5 4.5L21 15M3 4v5h5M21 20v-5h-5";
    out property <string> chevron-down: "M6 9l6 6 6-6";
    out property <string> chevron-up: "M6 15l6-6 6 6";
    out property <string> close: "M6 6l12 12M18 6L6 18";
    out property <string> edit: "M4 20h4l10-10-4-4L4 16zM13 7l4 4";
    out property <string> trash: "M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13M10 11v6M14 11v6";
    out property <string> up: "M12 19V5M5 12l7-7 7 7";
    out property <string> down: "M12 5v14M5 12l7 7 7-7";
    out property <string> copy: "M9 9h11v11H9zM5 15H4V4h11v1";
    out property <string> power: "M12 3v9M6.3 6.3a8 8 0 1 0 11.4 0";
    out property <string> check: "M5 12l5 5 9-10";
    out property <string> warning: "M12 3L2 20h20zM12 9v5M12 17v1";
    out property <string> info: "M12 3a9 9 0 1 0 0.01 0M12 11v6M12 7v1";
}

export component Icon inherits Path {
    in property <string> name;
    in property <color> tint: Theme.text-muted;
    in property <length> size: 18px;
    width: size;
    height: size;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: name;
    stroke: tint;
    stroke-width: 1.8px;
    stroke-line-cap: LineCap.round;
    fill: transparent;
}
