import { Theme } from "../theme.slint";
import { App } from "../state.slint";
import { Icon, Icons } from "../icons.slint";
import { Card, SectionTitle, Label, Hint, Btn, Toggle, Badge, StatTile, KVRow, Sparkline, LegendDot, EmptyState, Notice, PageHeader, PageBody, Divider } from "../controls.slint";
import { MappingRow, PeerRow, EventRow } from "../models.slint";

component MiniMapping inherits Rectangle {
    in property <MappingRow> item;
    callback activated();
    accessible-role: button;
    accessible-label: "管理服务 " + item.id;
    accessible-action-default => { root.activated(); }
    forward-focus: focus;
    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") { root.activated(); return accept; }
            return reject;
        }
    }
    border-width: focus.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    height: 44px;
    border-radius: Theme.radius;
    background: ta.has-hover ? Theme.surface-hover : transparent;
    animate background { duration: Theme.motion-fast; }
    HorizontalLayout {
        padding-left: Theme.space-2;
        padding-right: Theme.space-2;
        spacing: Theme.space-3;
        Rectangle {
            width: 30px; height: 30px; border-radius: 8px;
            y: (parent.height - self.height) / 2;
            background: item.role == "provide" ? Theme.accent-soft : Theme.surface-alt;
            Text {
                text: item.role == "provide" ? "供" : "用";
                horizontal-alignment: center;
                vertical-alignment: center;
                font-size: Theme.font-sm; font-weight: 700;
                color: item.role == "provide" ? Theme.accent : Theme.text-muted;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            Text { text: item.id; font-size: Theme.font-body; font-weight: 500; color: Theme.text; overflow: elide; }
            Text { text: item.endpoint; font-size: Theme.font-xs; color: Theme.text-muted; overflow: elide; }
        }
        Badge { text: item.state-label; kind: item.kind; y: (parent.height - self.height) / 2; }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.activated(); } }
}

component MiniPeer inherits Rectangle {
    in property <PeerRow> item;
    height: 52px;
    border-radius: Theme.radius;
    background: Theme.surface-alt;
    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        spacing: Theme.space-3;
        Rectangle {
            width: 8px; height: 8px; border-radius: 4px;
            y: (parent.height - self.height) / 2;
            background: Theme.kind-color(item.kind);
        }
        VerticalLayout {
            alignment: center; spacing: 1px; horizontal-stretch: 1;
            Text { text: item.peer-id; font-size: Theme.font-body; font-weight: 600; color: Theme.text; overflow: elide; }
            Text { text: item.path-label + " · " + item.state-label; font-size: Theme.font-xs; color: Theme.text-muted; overflow: elide; }
        }
        VerticalLayout {
            alignment: center; spacing: 1px;
            Text { text: item.rtt; font-size: Theme.font-body; color: Theme.text; horizontal-alignment: right; }
            Text { text: item.channels + " 通道"; font-size: Theme.font-xs; color: Theme.text-muted; horizontal-alignment: right; }
        }
    }
}

component EventLine inherits HorizontalLayout {
    in property <EventRow> item;
    spacing: Theme.space-3;
    Text { text: item.time; font-size: Theme.font-xs; color: Theme.text-faint; width: 64px; vertical-alignment: center; }
    Rectangle { width: 6px; height: 6px; border-radius: 3px; background: Theme.kind-color(item.level); y: (parent.height - self.height) / 2; }
    Text { text: item.summary; font-size: Theme.font-sm; color: Theme.text; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
}

export component OverviewPage inherits VerticalLayout {
    callback open-page(string);
    spacing: 0px;

    PageHeader {
        title: "连接";
        subtitle: "";
        Btn { text: "连接设置"; clicked => { root.open-page("settings"); } }
        if App.status.run-requested : Btn { text: "重新连接"; icon: Icons.transport; clicked => { App.reconnect(); } }
    }

    PageBody {
        VerticalLayout {
            spacing: Theme.space-3;
            HorizontalLayout {
                spacing: Theme.space-3;
                Rectangle {
                    width: 10px; height: 10px; border-radius: 5px;
                    y: (parent.height - self.height) / 2;
                    background: Theme.kind-color(App.status.kind);
                }
                Text { text: App.status.title; font-size: 30px; font-weight: 600; color: Theme.text; horizontal-stretch: 1; }
                Btn { text: "刷新"; kind: "ghost"; icon: Icons.refresh; enabled: !App.status.busy; clicked => { App.refresh(); } }
            }
            Label {
                text: App.connection.room == "" ? "填写房间信息，让两台设备连接到一起。" : "房间 " + App.connection.room + " · " + App.status.signal-label;
                muted: true;
            }
            if App.status.run-requested : Hint {
                text: "已连接 " + App.status.peers-active + " 台设备 · " + App.status.active-channels + " 个可用服务 · " + App.status.uptime;
            }
            if App.status.error != "" : Notice { text: App.status.error; kind: "bad"; }
            if App.status.command-error != "" : Notice { text: App.status.command-error; kind: "warn"; }
            if App.status.config-error != "" : Notice { text: App.status.config-error; kind: "warn"; }
            if App.status.bridge-error != "" : Notice { text: App.status.bridge-error; kind: "bad"; }
            if App.connection.room == "" : HorizontalLayout {
                alignment: start;
                Btn { text: "设置连接"; kind: "primary"; clicked => { root.open-page("settings"); } }
            }
        }
        Rectangle { height: Theme.space-3; }
        Divider { }


        // ---- 设备与映射 ----
        VerticalLayout {
            spacing: Theme.space-5;
            VerticalLayout {
                horizontal-stretch: 2;
                spacing: Theme.space-3;
                HorizontalLayout {
                    alignment: space-between;
                    SectionTitle { text: "我的服务"; }
                    Btn { kind: "ghost"; compact: true; text: "管理 ›"; clicked => { root.open-page("mappings"); } }
                }
                if App.provides.length == 0 && App.consumes.length == 0 : EmptyState {
                    icon: Icons.mappings;
                    title: "添加第一个服务";
                    description: "提供本机服务，或将远端服务接到本地端口。";
                }
                if App.provides.length == 0 && App.consumes.length == 0 : Btn {
                    text: "添加服务"; kind: "primary";
                    clicked => { root.open-page("mappings"); }
                }
                for row in App.provides : MiniMapping { item: row; activated => { root.open-page("mappings"); } }
                for row in App.consumes : MiniMapping { item: row; activated => { root.open-page("mappings"); } }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Theme.space-3;
                HorizontalLayout {
                    alignment: space-between;
                    SectionTitle { text: "对端设备"; }
                    Btn { kind: "ghost"; compact: true; text: "全部 ›"; clicked => { root.open-page("devices"); } }
                }
                if App.peers.length == 0 : EmptyState {
                    icon: Icons.devices;
                    title: App.status.run-requested ? "等待对端设备" : "连接尚未开启";
                    description: App.status.run-requested ? "让另一台设备加入同一个房间。" : "开启侧栏连接开关后，这里会显示同房间的设备。";
                }
                for peer in App.peers : MiniPeer { item: peer; }
            }
        }

        // ---- 流量与网络 ----
        if App.status.run-requested : HorizontalLayout {
            spacing: Theme.space-4;
            Card {
                horizontal-stretch: 3;
                HorizontalLayout {
                    alignment: space-between;
                    SectionTitle { text: "线路流量"; subtitle: "所有对端合计，包含协议开销"; }
                    VerticalLayout {
                        alignment: start; spacing: 2px;
                        Text { text: "↑ " + App.status.traffic-rate-up; font-size: Theme.font-md; font-weight: 600; color: Theme.series-up; horizontal-alignment: right; }
                        Text { text: "↓ " + App.status.traffic-rate-down; font-size: Theme.font-md; font-weight: 600; color: Theme.series-down; horizontal-alignment: right; }
                    }
                }
                Sparkline { up: App.status.sparkline-up; down: App.status.sparkline-down; }
                HorizontalLayout {
                    spacing: Theme.space-4;
                    LegendDot { color: Theme.series-up; text: "发送 累计 " + App.status.traffic-up; }
                    LegendDot { color: Theme.series-down; text: "接收 累计 " + App.status.traffic-down; }
                }
            }
            Card {
                horizontal-stretch: 2;
                SectionTitle { text: "本机网络"; }
                KVRow { key: "网络"; value: App.status.network-label; }
                KVRow { key: "状态"; value: App.status.network-state; }
                KVRow { key: "连接策略"; value: App.status.policy-label; }
                KVRow { key: "恢复记录"; value: App.status.recovery-text; }
                HorizontalLayout { alignment: start; Btn { kind: "ghost"; compact: true; text: "查看诊断 ›"; clicked => { root.open-page("diagnostics"); } } }
            }
        }

        // ---- 最近事件 ----
        if App.events.length > 0 : VerticalLayout {
            spacing: Theme.space-3;
            HorizontalLayout {
                alignment: space-between;
                SectionTitle { text: "最近活动"; }
                Btn { kind: "ghost"; compact: true; text: "全部 ›"; clicked => { root.open-page("diagnostics"); } }
            }
            if App.events.length == 0 : Hint { text: "尚无事件。"; }
            for ev[i] in App.events : EventLine { item: ev; visible: i < 6; height: i < 6 ? 24px : 0px; }
        }
    }
}
